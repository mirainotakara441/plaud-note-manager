SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# Basic認証（両方セットで有効化・未設定なら認証なし）。Vercelにも登録してRedeployで保護ON。
# DASHBOARD_USER=好きなユーザー名
# DASHBOARD_PASS=十分に長いパスワード

# 任意: 連携ダッシュボードにNotionの最新登録状況を表示したい場合のみ設定
# NOTION_TOKEN=secret_xxx
# NOTION_DB_LEARNING=学び・ナレッジDBのID
# NOTION_DB_MEETING=会議DBのID

# NotionのDB/ページIDは「env優先・コード内の現行値をフォールバック」に統一済み。
# 未設定でも従来どおり動くので、DBを差し替えたいときだけ設定する。
#
# NOTION_DB_DIARY  : 一行日記DBのID
#   /api/status（最新登録状況の表示）と /api/diary（日記の登録先）の両方が読む。
# NOTION_DB_DIARY=一行日記DBのID
#
# NOTION_PARENT_PAGE_ID : 月報ページを作る親ページのID
#   /api/monthly-report が読む。既定は「🧠 AIワークOS」ページ。
# NOTION_PARENT_PAGE_ID=月報を作る親ページのID
