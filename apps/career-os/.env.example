# ── Supabase（AIワークOS と同じプロジェクトを使う。テーブルは career_ 接頭辞）──
SUPABASE_URL=https://zuadqnarsoykplkafyxv.supabase.co
# career_* は RLS 有効・anon ポリシー無しなので、読み書きとも service role キーを使う。
# 絶対に NEXT_PUBLIC_ を付けないこと（付けるとブラウザに露出する）。
SUPABASE_SERVICE_ROLE_KEY=

# ── 合言葉認証（proxy.ts / app/api/login）──
# 未設定だと全ページ・全APIが閉じる（フェイルクローズ）。必ず設定する。
APP_PASSPHRASE=
# 任意。設定すると cookie 値が SHA-256 から HMAC-SHA256 に切り替わる（強くなる）。
# 後から設定してもよいが、その時点で全端末の再ログインが1回必要になる。
AUTH_COOKIE_SECRET=

# ── Anthropic（メール分類・求人抽出・適合スコア）──
ANTHROPIC_API_KEY=
# 取込時の抽出・採点に使うモデル。既定は Sonnet（量が出るので）。
CAREER_EXTRACT_MODEL=claude-sonnet-5
# /fit の深掘り再採点に使うモデル。既定は Opus。
CAREER_FIT_MODEL=claude-opus-5

# ── Gmail API（OAuth。scripts/get-gmail-refresh-token.mjs で取得する）──
# 手順は docs/gmail-setup.md を参照。
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# 取込対象のGmailラベルID。既定は「転職」ラベル。
GMAIL_LABEL_ID=Label_82
# 1回の取込で取得する最大メール数（初回の遡り取込で増やす）。
GMAIL_MAX_RESULTS=60

# ── Vercel Cron ──
# /api/cron/ingest を無認証で叩かれないための共有シークレット。
# Vercel Cron は Authorization: Bearer <CRON_SECRET> を自動で付けてくれる。
CRON_SECRET=
